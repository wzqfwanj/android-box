# 统一按 LF 存储，避免 Windows 上开发、Linux 上部署时出现换行差异
* text=auto eol=lf

# 脚本 / 配置类显式声明为文本（便于 diff）
*.py text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.svg text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary
*.apk binary
*.tar.gz binary
