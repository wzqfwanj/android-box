[Unit]
Description=android-box (ARM cloud phone web bridge)
Documentation=https://github.com/wzqfwanj/android-box
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/android-box
EnvironmentFile=-/etc/android-box/cloud.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/android-box/app.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
