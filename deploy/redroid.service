# redroid.service —— 安卓容器（AOSP Android 11，x86_64），供 android-box 使用
#
# 作用：在应用机 dev（180.76.180.249）上用 Docker 常驻一个 redroid 容器，
#       ADB 只监听 127.0.0.1:5555，公网不可见；浏览器侧经 Caddy + android-box 访问。
#
# 安装步骤（应用机 root 执行；完整上下文见 deploy/DEPLOY.md）：
#   1) 离线导入镜像（应用机无法访问 Docker Hub）：
#        见 DEPLOY.md 第 1 节：skopeo 经国内源拉取 → docker save/load 或直接 docker load
#        docker images | grep redroid        # 期望 redroid/redroid 11.0.0-latest
#   2) 安装并启动本单元：
#        scp deploy/redroid.service dev:/etc/systemd/system/redroid.service
#        ssh dev 'chmod 0644 /etc/systemd/system/redroid.service; systemctl daemon-reload; systemctl enable --now redroid'
#   3) 自检：
#        systemctl status redroid --no-pager
#        docker ps --filter name=redroid
#        adb connect 127.0.0.1:5555 && adb devices
#        adb shell getprop sys.boot_completed     # 首次启动约 30~90s，返回 1 表示系统就绪
#
# 设计说明：
#   - binder：redroid 依赖 binder 驱动。ExecStartPre 负责 modprobe + 创建/挂载 binderfs，
#     因此重启后无需手工挂载（/dev 是 tmpfs，目录会重建）。模块参数持久化见
#     /etc/modprobe.d/binder_linux.conf 与 /etc/modules-load.d/binder_linux.conf（DEPLOY.md 第 2 节）。
#   - docker：要求 docker 已安装并运行；Requires=docker.service 会先拉起 docker。
#   - 前台运行：docker run 不加 -d，容器生命周期与本单元绑定；ExecStop 显式 docker stop。
#   - 内存：--memory 1536m --memory-swap 1792m（应用机 2 vCPU / 3.4GB，给宿主留余量）。
#     若 journalctl 出现 OOM 或容器被 kill，按实际内存调整这两个值（DEPLOY.md 第 11 节）。
#   - 端口：只绑 127.0.0.1:5555，绝不能改成 0.0.0.0（ADB 无鉴权）。
#   - 分辨率 480×854 / DPI 240：应用机只有 2 vCPU、且容器内是软件渲染（gpu_mode=guest），
#     实机压测 720p 约 5fps、480p 约 8fps；480p 是「够用」与「流畅」的折中。
#   - --rm：容器停止即删除，重启后是全新 Android，已安装 App 会丢失；持久化方案见 DEPLOY.md 第 10 节。
#   - 启动参数（androidboot.redroid_*）位于镜像名之后，传给容器内的 redroid 初始化脚本；
#     若需改分辨率/DPI/刷新率，以下方 ExecStart 为准并同步 README 的说明。

[Unit]
Description=redroid - Android 11 容器（AOSP x86_64，供 android-box 使用）
Documentation=https://github.com/wzqfwanj/android-box/blob/main/deploy/DEPLOY.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple

# 1) 加载 binder 驱动（模块不存在/已加载时用 - 前缀容忍，真正缺驱动时 docker run 仍会失败并进日志）
# 2) 准备 binderfs 挂载点并挂载；已挂载则跳过，避免重复 mount 报错
ExecStartPre=-/sbin/modprobe binder_linux
ExecStartPre=/bin/mkdir -p /dev/binderfs
ExecStartPre=/bin/sh -c 'mountpoint -q /dev/binderfs || mount -t binder binder /dev/binderfs'

# 前台运行容器；参数含义：
#   --rm                                 停止即删除容器（重启即全新系统）
#   --privileged                         redroid 需要（binder / ashmem / 设备访问）
#   --memory 1536m --memory-swap 1792m   内存上限 1.5G + 256M swap
#   -p 127.0.0.1:5555:5555               ADB 仅本机可达
#   -v /dev/binderfs:/dev/binderfs       把宿主 binderfs 传给容器
#   镜像名之后为 androidboot.redroid_* 启动参数（宽 720 / 高 1280 / dpi 320 / 软件渲染 / 15fps）
ExecStart=/usr/bin/docker run --rm --name redroid --privileged --memory 1536m --memory-swap 1792m -p 127.0.0.1:5555:5555 -v /dev/binderfs:/dev/binderfs redroid/redroid:11.0.0-latest androidboot.redroid_width=480 androidboot.redroid_height=854 androidboot.redroid_dpi=240 androidboot.redroid_gpu_mode=guest androidboot.redroid_fps=15

ExecStop=/usr/bin/docker stop redroid
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
